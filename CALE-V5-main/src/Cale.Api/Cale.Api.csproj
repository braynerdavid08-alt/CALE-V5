<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Cale.BuildingBlocks.Domain\Cale.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\Cale.BuildingBlocks.Infrastructure\Cale.BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\Cale.Modules.Identity\Cale.Modules.Identity.csproj" />
    <ProjectReference Include="..\Cale.Modules.Catalog\Cale.Modules.Catalog.csproj" />
    <ProjectReference Include="..\Cale.Modules.Assessment\Cale.Modules.Assessment.csproj" />
    <ProjectReference Include="..\Cale.Modules.Classroom\Cale.Modules.Classroom.csproj" />
    <ProjectReference Include="..\Cale.Modules.Engagement\Cale.Modules.Engagement.csproj" />
    <ProjectReference Include="..\Cale.Modules.Presentation\Cale.Modules.Presentation.csproj" />
    <ProjectReference Include="..\Cale.Modules.LiveClassroom\Cale.Modules.LiveClassroom.csproj" />
    <ProjectReference Include="..\Cale.Modules.TheoreticalTraining\Cale.Modules.TheoreticalTraining.csproj" />
    <ProjectReference Include="..\Cale.Modules.GameShow\Cale.Modules.GameShow.csproj" />
    <ProjectReference Include="..\Cale.Modules.Courses\Cale.Modules.Courses.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="SeedData\**\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Legal\Drafts\*.md" LogicalName="Cale.Api.Legal.Drafts.%(Filename).md" />
  </ItemGroup>

  <Target Name="EnsureLegalDrafts" BeforeTargets="BeforeBuild">
    <Error
      Condition="!Exists('Legal\Drafts\terms.md') Or !Exists('Legal\Drafts\privacy.md') Or !Exists('Legal\Drafts\data-processing.md') Or !Exists('Legal\Drafts\school-terms.md') Or !Exists('Legal\Drafts\ai-policy.md')"
      Text="Faltan borradores legales en Legal\Drafts (*.md). Si compilas con Docker, revisa que .dockerignore no los excluya." />
  </Target>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
